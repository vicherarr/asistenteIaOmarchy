# Configuración de AsistenteIA

# API Server
HOST=127.0.0.1
PORT=8765
DEBUG=False

# Assistant Settings
MAX_HISTORY=2

# TTS Settings
# Voces Español (e): em_alex (Mateo), em_santa (Profunda), ef_dora (Mujer)
# Voces Inglés (a/b): af_heart, af_bella, am_adam, bf_emma, bm_george
KOKORO_VOICE=em_santa
KOKORO_LANG=e

# Wake Word Settings
WAKE_WORD_ENABLED=False
WAKE_WORD_MODEL=hey_mycroft
WAKE_WORD_THRESHOLD=0.5

