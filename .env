# Configuración de AsistenteIA

# API Server
HOST=127.0.0.1
PORT=8765
DEBUG=False

# LiteRT Settings
LITERT_BACKEND=gpu

# Assistant Settings
MAX_HISTORY=2

# TTS Settings
# Voces Español (e): em_alex (Mateo), em_santa (Profunda), ef_dora (Mujer)
# Voces Inglés (a/b): af_heart, af_bella, am_adam, bf_emma, bm_george
KOKORO_VOICE=em_santa
KOKORO_LANG=e

# Wake Word Settings (Sherpa-ONNX KWS)
WAKE_WORD_ENABLED=True
WAKE_WORD_KEYWORDS_FILE=models/sherpa-kws/keywords.txt
WAKE_WORD_MODEL_DIR=models/sherpa-kws
WAKE_WORD_THRESHOLD=0.01

# STT Settings (faster-whisper / CTranslate2 en CPU)
# Modelo: nombre (large-v3-turbo, large-v3, medium, small...) o ruta a un modelo CT2.
STT_MODEL=large-v3-turbo
STT_DEVICE=cpu
# Cuantización (CPU). Cambia entre estas para más velocidad o más calidad:
#   int8     -> ~3.0s/comando, máx. velocidad, menos RAM
#   int16    -> ~4.0s/comando, intermedio
#   float32  -> ~5.1s/comando, sin cuantizar, máx. calidad
STT_COMPUTE_TYPE=int16
STT_LANGUAGE=es
STT_THREADS=8
# VAD Silero: recorta silencios y evita alucinaciones
STT_VAD=True
# Reconocimiento: False = Whisper (actual) | True = audio nativo del modelo Gemma
STT_USE_GEMMA_AUDIO=True

# Seguridad y Cifrado
API_TOKEN=SRjkHozuhPsSgNW7zOJtvQ
SSL_KEYFILE=config/certs/key.pem
SSL_CERTFILE=config/certs/cert.pem

