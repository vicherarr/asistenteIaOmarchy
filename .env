# Configuración de AsistenteIA

# API Server
HOST=127.0.0.1
PORT=8765
DEBUG=False

# --- OLLAMA MODELS (Descomenta solo uno) ---
# Gemma 4 2B (Equilibrio perfecto velocidad/precisión, Google) - RECOMENDADO
OLLAMA_MODEL=gemma4:e2b

# Gemma 3 1B (Ultra ligero, Google)
# OLLAMA_MODEL=gemma:1b

# Ministral 3B (El estándar para razonamiento y ejecución de comandos)
# OLLAMA_MODEL=ministral-3:3b

# Gemma 4 4B (Máxima inteligencia local, requiere más GPU)
# OLLAMA_MODEL=gemma4:e4b

# Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120.0
OLLAMA_TEMPERATURE=0.0
OLLAMA_NUM_CTX=4096

# Assistant Settings
MAX_HISTORY=3

# TTS Settings
KOKORO_VOICE=em_alex
KOKORO_LANG=e
