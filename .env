# Configuración de AsistenteIA

# API Server
HOST=127.0.0.1
PORT=8765
DEBUG=False

# LiteRT Settings
LITERT_BACKEND=gpu

# Assistant Settings
MAX_HISTORY=2

# TTS Settings
# Voces Español (e): em_alex (Mateo), em_santa (Profunda), ef_dora (Mujer)
# Voces Inglés (a/b): af_heart, af_bella, am_adam, bf_emma, bm_george
KOKORO_VOICE=em_santa
KOKORO_LANG=e

# Wake Word Settings (Sherpa-ONNX KWS)
WAKE_WORD_ENABLED=True
WAKE_WORD_KEYWORDS_FILE=models/sherpa-kws/keywords.txt
WAKE_WORD_MODEL_DIR=models/sherpa-kws
WAKE_WORD_THRESHOLD=0.10

# STT Settings (Whisper / whisper-cli en CPU)
# Para alternar de modelo cambia STT_MODEL_PATH (usa ruta absoluta, ~ no se expande):
#   Preciso (~6s):  /home/victor/.cache/whisper/ggml-large-v3-turbo.bin
#   Rápido  (~2.4s): /home/victor/.cache/whisper/ggml-small.bin
#   [EXPERIMENTAL] /home/victor/.cache/whisper/ggml-medium.bin            (~6s, intermedio)
#   [EXPERIMENTAL] /home/victor/.cache/whisper/ggml-large-v3-turbo-q8_0.bin (~5.7s, turbo cuantizado q8)
#   [EXPERIMENTAL] /home/victor/.cache/whisper/ggml-large-v3-turbo-q5_0.bin (~5.7s, turbo cuantizado q5)
STT_MODEL_PATH=/home/victor/.cache/whisper/ggml-medium.bin
STT_LANGUAGE=es
STT_THREADS=8

# Seguridad y Cifrado
API_TOKEN=SRjkHozuhPsSgNW7zOJtvQ
SSL_KEYFILE=config/certs/key.pem
SSL_CERTFILE=config/certs/cert.pem

