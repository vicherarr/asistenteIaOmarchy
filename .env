# Configuración de AsistenteIA

# API Server
HOST=127.0.0.1
PORT=8765
DEBUG=False

# --- OLLAMA MODELS (Descomenta solo uno) ---
# Gemma 4 4B (Máxima inteligencia local, requiere más GPU)
OLLAMA_MODEL=gemma4:e4b

# Gemma 4 2B (Equilibrio perfecto velocidad/precisión, Google)
# OLLAMA_MODEL=gemma:2b-instruct-q8_0

# Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120.0
OLLAMA_TEMPERATURE=0.0
OLLAMA_NUM_CTX=4096

# Assistant Settings
MAX_HISTORY=2

# TTS Settings
# Voces Español (e): em_alex (Mateo), em_santa (Profunda), ef_dora (Mujer)
# Voces Inglés (a/b): af_heart, af_bella, am_adam, bf_emma, bm_george
KOKORO_VOICE=em_santa
KOKORO_LANG=e
