[Unit]
Description=AsistenteIA - Voice Assistant Orchestrator
After=network.target

[Service]
Type=simple
ExecStart=%h/develop/asistenteia/scripts/start-assistant.sh
WorkingDirectory=%h/develop/asistenteia
Restart=on-failure
RestartSec=5
Environment=PATH=%h/develop/asistenteia/venv/bin:/usr/local/bin:/usr/bin
Environment=PYTHONUNBUFFERED=1
Environment=DISPLAY=:0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus

StandardOutput=journal
StandardError=journal
SyslogIdentifier=asistenteia

[Install]
WantedBy=default.target
