#!/usr/bin/env bash
# =============================================================================
# asistenteia - Interfaz de línea de comandos de AsistenteIA
# =============================================================================
# Se instala como symlink en ~/.local/bin/asistenteia. Resuelve su ruta real
# para localizar la instalación, sin rutas hardcodeadas.
# =============================================================================

set -uo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPTS_DIR="$(dirname "$SELF")"
# shellcheck source=_common.sh
source "$SCRIPTS_DIR/_common.sh"

# Modelos Gemma 4 disponibles.
#   E2B/E4B: audio + visión nativos (recomendados para uso general).
#   12B:     más capaz y con 32k de contexto, audio nativo, pero AÚN NO soporta
#            imágenes (el análisis de pantalla no funcionará hasta que LiteRT-LM
#            añada soporte de imagen para este modelo).
# Devuelve "REPO|FICHERO|TAMAÑO|CAPACIDADES" para la clave dada (e2b/e4b/12b).
ai_model_meta() {
    case "$1" in
        e2b) echo "litert-community/gemma-4-E2B-it-litert-lm|gemma-4-E2B-it.litertlm|2.6 GB|audio+visión" ;;
        e4b) echo "litert-community/gemma-4-E4B-it-litert-lm|gemma-4-E4B-it.litertlm|3.7 GB|audio+visión" ;;
        12b) echo "litert-community/gemma-4-12B-it-litert-lm|gemma-4-12B-it.litertlm|6.6 GB|audio, sin imagen aún" ;;
        *)   return 1 ;;
    esac
}

# Backend recomendado para cada modelo según la VRAM disponible. El backend es
# una propiedad del modelo+hardware, no global: así, cambiar de modelo restaura
# el backend correcto (p.ej. volver a E4B reactiva GPU) sin que el ajuste de un
# modelo "contamine" a los demás. Mismo criterio de holgura que el instalador.
#   12B: SIEMPRE GPU. El .litertlm trae el decoder principal con restricción
#        "section_backend_constraint: gpu", así que en CPU el motor se niega a
#        cargar. Necesita una GPU holgada (~12 GiB+); en 8 GiB no entra.
#   E4B: GPU si VRAM >= 7 GiB, si no CPU.
#   E2B: GPU si VRAM >= 5 GiB, si no CPU.
ai_model_backend() {
    local vram; vram="$(detect_vram_mib)"
    case "$1" in
        12b) echo gpu ;;
        e4b) [ "$vram" -ge 7168 ] && echo gpu || echo cpu ;;
        e2b) [ "$vram" -ge 5120 ] && echo gpu || echo cpu ;;
        *)   echo gpu ;;
    esac
}

ai_hermes_tts_cmd() {
    local val="${1:-}"
    local cur_on=0
    if ai_hermes_tts_enabled; then
        cur_on=1
    fi
    if [ -z "$val" ] || [ "$val" = status ]; then
        [ "$cur_on" = 1 ] && echo "TTS propio de Hermes: ACTIVADO" \
                          || echo "TTS propio de Hermes: desactivado"
        echo "Uso: asistenteia engine hermes tts on|off"
        exit 0
    fi
    local new_on=0 new_val="False"
    case "$(printf '%s' "$val" | tr 'A-Z' 'a-z')" in
        on|true|1|yes|si|sí) new_on=1; new_val=True ;;
        off|false|0|no)      new_on=0; new_val=False ;;
        *) err "Valor no válido: '$val'. Usa on u off."; exit 1 ;;
    esac
    if [ "$new_on" = "$cur_on" ]; then
        echo "El TTS de Hermes ya está $([ "$new_on" = 1 ] && echo activado || echo desactivado). Nada que hacer."
        exit 0
    fi
    ai_set_env_key HERMES_TTS "$new_val"
    [ "$new_on" = 1 ] && echo "TTS propio de Hermes activado." || echo "TTS propio de Hermes desactivado."
    if [ "$new_on" = 1 ]; then
        warn "Hermes usará su herramienta 'text_to_speech' cuando lo decida."
        warn "Ten en cuenta que esto produce audio por fuera del pipeline de Luka."
    fi
    if [ "$(ai_engine)" != hermes ]; then
        warn "El motor activo es '$(ai_engine)': este ajuste aplica al motor hermes."
        echo "Se aplicará al cambiar de motor: asistenteia engine hermes"
        exit 0
    fi
    if ai_server_up; then
        echo "Reiniciando para aplicar..."
        "$SCRIPTS_DIR/stop-assistant.sh" >/dev/null 2>&1 || true
        sleep 1
        case "$(ai_ensure_running 240)" in
            error) err "No arrancó. Revisa: asistenteia logs"; exit 1 ;;
            *)     ok "Listo: ajuste de TTS de Hermes aplicado." ;;
        esac
    else
        echo "Hecho. Se aplicará al arrancar (asistenteia start o Super + Z)."
    fi
    exit 0
}

ai_hermes_model_cmd() {
    local key="${1:-}"
    local cur_model; cur_model="$(ai_hermes_model)"
    local is_or=0
    ai_hermes_use_openrouter && is_or=1

    if [ -z "$key" ] || [ "$key" = list ] || [ "$key" = status ]; then
        if [ "$is_or" = 1 ]; then
            echo "Motor Hermes actual: OpenRouter (nube) -> ${C_CYAN}$cur_model${C_RESET}"
        else
            echo "Motor Hermes actual: Local GPU (TabbyAPI) -> ${C_CYAN}$cur_model${C_RESET}"
        fi
        echo
        echo "Catálogo de modelos para Hermes (>= 64k contexto y soporte de herramientas):"
        echo
        local i=0 ids=""
        while IFS='|' read -r mid malias mname mctx pin pout rec tag desc; do
            [ -z "$mid" ] && continue
            i=$((i + 1))
            ids="$ids $mid"
            local mark=" "
            if [ "$is_or" = 1 ] && [ "$mid" = "$cur_model" ]; then
                mark="*"
            elif [ "$is_or" = 0 ] && [ "$mid" = "local" ]; then
                mark="*"
            fi
            local price_str="$pin / $pout"
            [ "$pin" = "$0.00" ] && [ "$pout" = "$0.00" ] && price_str="gratis"
            [ "$mid" = "local" ] && price_str="local (GPU)"

            printf "  %s %2d) %-37s %-9s %-15s %s\n" "$mark" "$i" "$mid" "$((mctx / 1000))k ctx" "$price_str" "$tag"
            printf "         ↳ %s\n" "$desc"
        done < <(ai_hermes_models --list)

        echo
        echo "  * También puedes escribir cualquier otro id de modelo de OpenRouter (ej. anthropic/claude-3.5-haiku)."
        echo
        [ "$key" = list ] || [ "$key" = status ] && exit 0
        if [ -r /dev/tty ]; then
            read -r -p "¿Qué modelo configuro para Hermes? [nº, alias o id] (Enter = cancelar): " key </dev/tty || key=""
        fi
        [ -z "$key" ] && { echo "Sin cambios."; exit 0; }
    fi

    # Resolver alias o ID con hermes-models.py
    local resolved=""
    if ! resolved="$(ai_hermes_models --check "$key" 2>/dev/null)"; then
        err "No se pudo validar el modelo o alias '$key'."
        echo "Consulta los disponibles con: asistenteia engine hermes model list"
        exit 1
    fi

    if [ "$resolved" = "local" ]; then
        ai_set_env_key HERMES_USE_OPENROUTER False
        ai_hermes_sync_config
        ok "Hermes configurado para usar Local GPU (sidecar TabbyAPI - $HERMES_MODEL)."
        if ! ai_tabby_model_present "$HERMES_MODEL"; then
            warn "El modelo local ($HERMES_MODEL) no está descargado."
            warn "Descárgalo con: asistenteia engine pull turboderp/Qwen3.5-9B-exl3 3.00bpw"
        fi
    else
        ai_set_env_key HERMES_USE_OPENROUTER True
        ai_set_env_key HERMES_OPENROUTER_MODEL "$resolved"
        ai_hermes_sync_config
        ok "Hermes configurado para usar OpenRouter (nube): $resolved"
        local or_k; or_k="$(ai_openrouter_key)"
        if [ -z "$or_k" ]; then
            warn "No hay API key de OpenRouter configurada en .env."
            warn "Configúrala con: asistenteia engine openrouter key <TU_API_KEY>"
        fi
    fi

    if [ "$(ai_engine)" != hermes ]; then
        warn "El motor activo es '$(ai_engine)'. Activa Hermes con: asistenteia engine hermes"
        exit 0
    fi

    if ai_server_up; then
        echo "Reiniciando para aplicar el nuevo modelo de Hermes..."
        "$SCRIPTS_DIR/stop-assistant.sh" >/dev/null 2>&1 || true
        sleep 1
        case "$(ai_ensure_running 180)" in
            error) err "No arrancó. Revisa: asistenteia logs"; exit 1 ;;
            *)     ok "Listo: Hermes en marcha con el nuevo modelo." ;;
        esac
    else
        echo "Hecho. Se aplicará al arrancar (asistenteia start o Super + Z)."
    fi
    exit 0
}

ai_hermes_fallback_cmd() {
    local key="${1:-}"
    local cur_fb; cur_fb="$(ai_hermes_fallback_models)"

    if [ -z "$key" ] || [ "$key" = list ] || [ "$key" = status ]; then
        echo "Modelo fallback actual de Hermes: ${C_CYAN}${cur_fb:-ninguno}${C_RESET}"
        echo
        echo "El modelo de fallback se activa automáticamente en Hermes si el modelo"
        echo "primario falla o para tareas de alta complejidad (fallback_providers)."
        echo
        echo "Opciones recomendadas:"
        echo "  • minimax   -> minimax/minimax-m2.5 (⭐ 204k ctx, alta capacidad agéntica)"
        echo "  • llama3.3  -> meta-llama/llama-3.3-70b-instruct"
        echo "  • gemini    -> google/gemini-2.5-flash (1M ctx)"
        echo "  • none      -> deshabilitar fallback"
        echo
        [ "$key" = list ] || [ "$key" = status ] && exit 0
        if [ -r /dev/tty ]; then
            read -r -p "¿Qué modelo de fallback configuro? [alias, id o 'none'] (Enter = cancelar): " key </dev/tty || key=""
        fi
        [ -z "$key" ] && { echo "Sin cambios."; exit 0; }
    fi

    if [ "$key" = "none" ] || [ "$key" = "off" ] || [ "$key" = "clear" ]; then
        ai_set_env_key HERMES_FALLBACK_MODELS ""
        ai_hermes_sync_config
        ok "Fallback de Hermes deshabilitado."
        exit 0
    fi

    local resolved=""
    if ! resolved="$(ai_hermes_models --check "$key" 2>/dev/null)"; then
        err "No se pudo validar el modelo de fallback '$key'."
        exit 1
    fi

    ai_set_env_key HERMES_FALLBACK_MODELS "$resolved"
    ai_hermes_sync_config
    ok "Modelo de fallback para Hermes configurado: $resolved"

    if [ "$(ai_engine)" != hermes ]; then
        warn "El motor activo es '$(ai_engine)'. Activa Hermes con: asistenteia engine hermes"
        exit 0
    fi

    if ai_server_up; then
        echo "Reiniciando para aplicar el cambio de fallback..."
        "$SCRIPTS_DIR/stop-assistant.sh" >/dev/null 2>&1 || true
        sleep 1
        case "$(ai_ensure_running 180)" in
            error) err "No arrancó. Revisa: asistenteia logs"; exit 1 ;;
            *)     ok "Listo: fallback de Hermes actualizado." ;;
        esac
    else
        echo "Hecho. Se aplicará al arrancar (asistenteia start o Super + Z)."
    fi
    exit 0
}

usage() {
    cat <<EOF
AsistenteIA - uso: asistenteia <comando>

  start        Arranca el asistente (servicio si está instalado, si no proceso)
  stop         Detiene el asistente
  restart      Reinicia el asistente
  toggle       Arranca/alterna la escucha (lo mismo que Super + Z)
  gui          Abre solo la interfaz visual (Spotlight)
  web          Abre la interfaz web de chat en el navegador (arranca si hace falta)
  api          Abre la documentación Swagger de la API (/docs) en el navegador
  invite       Genera la URL para que alguien se conecte desde la red local
  status       Muestra el estado del asistente
  model [m]    Cambia el modelo (e2b/e4b/12b): lo descarga si falta y reinicia.
               Sin argumento, muestra el actual y pregunta cuál usar.
               12b es más capaz (32k contexto) pero aún no soporta imágenes.
  engine [e]   Cambia el motor (litert/exllama/openrouter/hermes) y reinicia.
               Sin argumento, muestra el actual y los disponibles.
               engine hermes              Hermes Agent lleva el bucle; Luka, la voz.
               engine hermes model [m]    Elige modelo LLM (nube en OpenRouter o local).
               engine hermes fallback [f] Modelo de fallback para tareas complejas / failover.
               engine hermes install      Instala Hermes (clon + venv propio).
               engine hermes status       Instalación, modelo, contexto y tools MCP.
               engine hermes tts on|off   TTS propio de Hermes (text_to_speech).
               engine openrouter          LLM en la nube: sin VRAM, modelos gratis.
               engine openrouter model    Elige modelo gratis (marca los que ven imágenes).
               engine openrouter key <k>  Guarda la API key de openrouter.ai (solo en .env).
               engine openrouter status   Modelo, visión y key (enmascarada).
               engine install [m]  Instala el backend exllama (TabbyAPI + modelo).
               engine model [m]    Modelo curado: qwen3-8b / qwen3-vl / lfm2.5 (4 GiB).
               engine browse [f]   Lista modelos EXL3 de turboderp en HuggingFace.
               engine pull <repo> [bpw]  Descarga cualquier modelo EXL3 (de turboderp).
               engine use [m]      Activa un modelo descargado (funcione o no con tools).
               engine thinking on|off  Razonamiento <think> de Qwen3 (solo exllama).
               engine start|stop   Control manual del sidecar TabbyAPI.
  hermes [...]  Hermes suelto en la terminal (mismo modelo y mismas herramientas).
               Sin argumentos, chat interactivo. Con -z "...", una sola respuesta.
  logs         Muestra los logs en tiempo real
  service ...  Gestiona el servicio systemd: install | enable | disable | status | uninstall
  keybindings  (Re)configura los atajos Super+Z / Super+X
  google-auth  Inicia sesión con Google una vez (Gmail). Abre el navegador y guarda
               el token en ~/.config/asistenteia/google/. Requiere credentials.json.
  update       Actualiza el código (git pull) y sincroniza dependencias
  uninstall    Desinstala AsistenteIA
  help         Esta ayuda

Instalación: $PROJECT_DIR
EOF
}

cmd="${1:-help}"
shift || true

case "$cmd" in
    start)
        case "$(ai_ensure_running 60)" in
            already) echo "El asistente ya estaba en marcha ($BASE_URL)." ;;
            started) echo "Asistente iniciado ($BASE_URL)." ;;
            *)       err "No se pudo iniciar el asistente. Revisa: asistenteia logs"; exit 1 ;;
        esac
        ;;
    stop)
        exec "$SCRIPTS_DIR/stop-assistant.sh"
        ;;
    restart)
        "$SCRIPTS_DIR/stop-assistant.sh" >/dev/null 2>&1 || true
        sleep 1
        case "$(ai_ensure_running 60)" in
            error) err "No se pudo reiniciar."; exit 1 ;;
            *)     echo "Asistente reiniciado ($BASE_URL)." ;;
        esac
        ;;
    toggle)
        exec "$SCRIPTS_DIR/handy-toggle.sh"
        ;;
    gui)
        exec "$SCRIPTS_DIR/start-gui.sh"
        ;;
    web)
        # Asegura que el servidor está en marcha antes de abrir el navegador.
        case "$(ai_ensure_running 60)" in
            error) err "No se pudo iniciar el asistente. Revisa: asistenteia logs"; exit 1 ;;
            *)     : ;;
        esac
        # El token va en la query: chat.html lo guarda y limpia la URL al cargar.
        url="$BASE_URL/chat"
        [ -n "$API_TOKEN" ] && url="$url?token=$API_TOKEN"
        echo "Abriendo la interfaz web: $BASE_URL/chat"
        if command -v xdg-open >/dev/null 2>&1; then
            xdg-open "$url" >/dev/null 2>&1 &
        else
            warn "No se encontró 'xdg-open'. Abre esta URL manualmente:"
            echo "  $url"
        fi
        ;;
    api)
        # Asegura que el servidor está en marcha antes de abrir Swagger.
        case "$(ai_ensure_running 60)" in
            error) err "No se pudo iniciar el asistente. Revisa: asistenteia logs"; exit 1 ;;
            *)     : ;;
        esac
        url="$BASE_URL/docs"
        echo "Abriendo la documentación Swagger de la API: $url"
        if command -v xdg-open >/dev/null 2>&1; then
            xdg-open "$url" >/dev/null 2>&1 &
        else
            warn "No se encontró 'xdg-open'. Abre esta URL manualmente:"
            echo "  $url"
        fi
        ;;
    invite)
        ip="$(ai_lan_ip)"
        if [ -z "$ip" ]; then
            err "No se pudo averiguar la IP de la red local. ¿Estás conectado a la red?"
            exit 1
        fi

        # 1) ¿Permitir conexión externa? Solo es accesible desde la red si el
        #    servidor escucha en 0.0.0.0 (no en 127.0.0.1).
        host="$(ai_read_env HOST 127.0.0.1)"
        restart_needed=0
        if [ "$host" = "127.0.0.1" ] || [ "$host" = "localhost" ]; then
            warn "Ahora el asistente solo escucha en local (HOST=$host): nadie de la red puede conectar."
            if ai_confirm "¿Quieres permitir el acceso desde otros dispositivos de tu red?"; then
                ai_set_env_key HOST 0.0.0.0
                ok "Guardado HOST=0.0.0.0 en el .env."
                restart_needed=1
            else
                echo "De acuerdo: la URL solo funcionará en este mismo equipo."
            fi
        else
            ok "El asistente ya escucha en HOST=$host (accesible desde la red)."
        fi

        # 2) Firewall: comprobar y, si procede, abrir el puerto que usa el .env.
        ai_firewall_open "$PORT"

        # 3) Aplicar el cambio de HOST reiniciando (si hizo falta y está en marcha).
        if [ "$restart_needed" = 1 ]; then
            if ai_server_up; then
                if ai_confirm "¿Reiniciar ahora para aplicar el acceso externo?"; then
                    "$SCRIPTS_DIR/stop-assistant.sh" >/dev/null 2>&1 || true
                    sleep 1
                    case "$(ai_ensure_running 90)" in
                        error) err "No se pudo reiniciar. Revisa: asistenteia logs"; exit 1 ;;
                        *)     ok "Reiniciado: ya acepta conexiones externas." ;;
                    esac
                else
                    warn "Recuerda: 'asistenteia restart' para que el acceso externo surta efecto."
                fi
            else
                echo "Se aplicará al arrancar (asistenteia start o Super + Z)."
            fi
        fi

        # 4) URL + QR para compartir.
        url="$PROTO://$ip:$PORT/chat"
        [ -n "$API_TOKEN" ] && url="$url?token=$API_TOKEN"
        echo
        echo "Comparte esta URL con quien esté en tu misma red local:"
        echo
        printf '  %s%s%s\n' "$C_CYAN" "$url" "$C_RESET"
        echo
        # Un QR viene de perlas para conectar el móvil; solo si está disponible.
        if command -v qrencode >/dev/null 2>&1; then
            qrencode -t ANSIUTF8 "$url"
            echo
        else
            warn "Instala 'qrencode' para mostrar un código QR (sudo pacman -S qrencode)."
        fi
        if [ "$PROTO" = "https" ]; then
            echo "Nota: el certificado es autofirmado; el navegador avisará (acepta el riesgo)."
        fi
        ;;
    status)
        if ai_server_up; then
            echo "Estado: EN MARCHA ($BASE_URL)"
            curl -sk "$BASE_URL/status" -H "X-API-Token: $API_TOKEN" 2>/dev/null || true
            echo
        else
            echo "Estado: DETENIDO"
        fi
        if ai_service_installed; then
            ai_service_active && echo "Servicio systemd: activo" || echo "Servicio systemd: instalado (parado)"
        else
            echo "Servicio systemd: no instalado (modo bajo demanda)"
        fi
        ;;
    logs)
        if ai_service_installed; then
            journalctl --user -u "$SERVICE_NAME" -f
        elif [ -f "$LOG_FILE" ]; then
            tail -n 100 -f "$LOG_FILE"
        else
            err "No hay logs disponibles todavía."
            exit 1
        fi
        ;;
    service)
        sub="${1:-status}"
        case "$sub" in
            install)   exec bash "$PROJECT_DIR/installservice.sh" ;;
            enable)    exec bash "$PROJECT_DIR/installservice.sh" --enable ;;
            disable)   systemctl --user disable --now "$SERVICE_NAME"; echo "Servicio deshabilitado." ;;
            uninstall) exec bash "$PROJECT_DIR/uninstallservice.sh" ;;
            status)    systemctl --user status "$SERVICE_NAME" --no-pager || true ;;
            *)         err "Subcomando de servicio no válido: $sub"; exit 1 ;;
        esac
        ;;
    keybindings)
        exec bash "$SCRIPTS_DIR/setup-keybindings.sh" "$PROJECT_DIR"
        ;;
    model)
        sub="${1:-}"
        cur_file="$(basename "$(ai_read_env LITERT_MODEL_PATH "models/gemma-4-E4B-it.litertlm")")"
        case "$cur_file" in *E2B*) cur_key=e2b ;; *E4B*) cur_key=e4b ;; *12B*) cur_key=12b ;; *) cur_key="?" ;; esac

        # 'model' gestiona los modelos de LiteRT. Con el motor exllama activo, el
        # modelo lo decide EXLLAMA_MODEL (+ el instalador): avisamos para no confundir.
        if ai_using_exllama; then
            warn "Motor activo: exllama. 'model' solo afecta a LiteRT (Gemma)."
            warn "Para el modelo EXL3: ajusta EXLLAMA_MODEL en .env y 'asistenteia engine install'."
            warn "Para usar Gemma, cambia de motor: 'asistenteia engine litert'."
            echo
        fi

        # Sin argumento (o list/status): mostrar el actual y los disponibles.
        if [ -z "$sub" ] || [ "$sub" = list ] || [ "$sub" = status ]; then
            echo "Modelo actual: $cur_file"
            echo
            echo "Disponibles:"
            for k in e2b e4b 12b; do
                IFS='|' read -r _repo file size caps < <(ai_model_meta "$k")
                estado="no descargado"; [ -f "$PROJECT_DIR/models/$file" ] && estado="descargado"
                marca=" "; [ "$k" = "$cur_key" ] && marca="*"
                printf "  %s %-3s  Gemma 4 %-3s (~%s, %s)  [%s]\n" "$marca" "$k" "${k^^}" "$size" "$caps" "$estado"
            done
            echo
            [ "$sub" = list ] || [ "$sub" = status ] && exit 0
            if [ -r /dev/tty ]; then
                read -r -p "¿A qué modelo cambiar? [e2b/e4b/12b] (Enter = cancelar): " sub </dev/tty || sub=""
            fi
            [ -z "$sub" ] && { echo "Sin cambios."; exit 0; }
        fi

        sub="$(printf '%s' "$sub" | tr 'A-Z' 'a-z')"
        if ! meta="$(ai_model_meta "$sub")"; then
            err "Modelo no válido: '$sub'. Usa e2b, e4b o 12b."; exit 1
        fi
        IFS='|' read -r repo file size caps <<<"$meta"
        target="$PROJECT_DIR/models/$file"

        # Backend que toca para este modelo+hardware y el que hay ahora en el .env.
        new_backend="$(ai_model_backend "$sub")"
        cur_backend="$(ai_read_env LITERT_BACKEND gpu)"

        if [ "$sub" = "$cur_key" ] && [ -f "$target" ] && [ "$new_backend" = "$cur_backend" ]; then
            echo "Ya estás usando Gemma 4 ${sub^^} ($file) en backend $new_backend. Nada que hacer."
            exit 0
        fi

        # El 12B aún no procesa imágenes en LiteRT-LM: el análisis de pantalla y
        # las tools de visión quedarán inoperativas hasta que Google lo añada.
        # Además es GPU-only y pesado: en GPUs pequeñas el motor no llega a cargar.
        if [ "$sub" = 12b ]; then
            warn "Gemma 4 12B no soporta imágenes todavía: las herramientas de visión"
            warn "(análisis de pantalla) no funcionarán. El resto (audio, texto, tools) sí."
            warn "Requiere GPU holgada (~12 GiB+ de VRAM). Es GPU-only: no carga en CPU,"
            warn "y en tarjetas pequeñas (p.ej. 8 GiB) el motor fallará al inicializar."
            cur_vram="$(detect_vram_mib)"
            if [ "$cur_vram" -gt 0 ] && [ "$cur_vram" -lt 12288 ]; then
                warn "Tu GPU tiene ~$(( cur_vram / 1024 )) GiB: probablemente NO arranque."
            fi
        fi

        if [ -f "$target" ]; then
            echo "Gemma 4 ${sub^^} ya está descargado."
        else
            echo "Descargando Gemma 4 ${sub^^} (~$size) desde HuggingFace..."
            "$PROJECT_DIR/venv/bin/python" - "$repo" "$file" "$PROJECT_DIR/models" <<'PY'
import sys
try:
    from huggingface_hub import hf_hub_download
except ImportError:
    import subprocess
    subprocess.check_call([sys.executable, "-m", "pip", "install", "-q", "huggingface_hub"])
    from huggingface_hub import hf_hub_download
repo, fname, dest = sys.argv[1], sys.argv[2], sys.argv[3]
hf_hub_download(repo_id=repo, filename=fname, local_dir=dest)
print("Descargado:", dest + "/" + fname)
