            if [ ! -f "$target" ]; then err "La descarga falló. Inténtalo de nuevo."; exit 1; fi
        fi

        ai_set_env_key LITERT_MODEL_PATH "models/$file"
        echo "Modelo activo: $file"

        # Ajusta el backend al recomendado para este modelo (CPU para 12B, GPU para
        # E2B/E4B si hay VRAM). Solo se escribe si cambia, para no tocar el .env sin
        # motivo. Así E2B/E4B vuelven a GPU aunque el 12B haya dejado el backend en CPU.
        if [ "$new_backend" != "$cur_backend" ]; then
            ai_set_env_key LITERT_BACKEND "$new_backend"
            echo "Backend ajustado: $cur_backend -> $new_backend (recomendado para ${sub^^})."
        fi

        if ai_using_exllama; then
            # No reiniciamos: con exllama activo, reiniciar cargaría el sidecar, no
            # este modelo Gemma. Surtirá efecto al volver a LiteRT.
            echo "Guardado. Se aplicará cuando cambies a LiteRT ('asistenteia engine litert')."
        elif ai_server_up; then
            echo "Reiniciando para cargar el nuevo modelo..."
            "$SCRIPTS_DIR/stop-assistant.sh" >/dev/null 2>&1 || true
            sleep 1
            case "$(ai_ensure_running 90)" in
                error) err "No arrancó con el nuevo modelo. Revisa: asistenteia logs"; exit 1 ;;
                *)     echo "Listo: asistente en marcha con Gemma 4 ${sub^^}." ;;
            esac
        else
            echo "Hecho. Se cargará al arrancar (asistenteia start o Super + Z)."
        fi
        ;;
    engine)
        sub="${1:-}"
        cur="$(ai_read_env AI_ENGINE litert)"

        # Subcomandos del motor OpenRouter (nube). Van los primeros para que
        # 'engine openrouter model' no se confunda con 'engine model' (que es de exllama).
        case "$sub" in
            hermes)
                # 'engine hermes' a secas cambia de motor (cae más abajo); con
                # subcomando, gestiona su modelo, instalación y configuración.
                case "${2:-}" in
                    model)
                        ai_hermes_model_cmd "${3:-}" ;;
                    fallback)
                        ai_hermes_fallback_cmd "${3:-}" ;;
                    install)
                        exec "$SCRIPTS_DIR/install-hermes.sh" "${@:3}" ;;
                    tts)
                        ai_hermes_tts_cmd "${3:-}" ;;
                    status)
                        echo "Motor actual:     $cur"
                        echo "Instalación:      $(ai_hermes_dir)"
                        ai_hermes_installed && echo "Estado:           instalado" \
                                            || echo "Estado:           NO instalado (asistenteia engine hermes install)"
                        if ai_hermes_use_openrouter; then
                            echo "Proveedor:        OpenRouter (nube)"
                            echo "Modelo primario:  $(ai_hermes_model)"
                            fb="$(ai_hermes_fallback_models)"
                            [ -n "$fb" ] && [ "$fb" != "none" ] \
                                && echo "Modelo fallback:  $fb (para tareas complejas / failover)" \
                                || echo "Modelo fallback:  desactivado (asistenteia engine hermes fallback minimax)"
                            echo "API key:          $(ai_openrouter_key_masked)"
                        else
                            echo "Proveedor:        Local GPU (sidecar TabbyAPI)"
                            echo "Modelo:           $HERMES_MODEL"
                            ai_tabby_model_present "$HERMES_MODEL" \
                                && echo "                  (descargado)" \
                                || echo "                  (SIN descargar: asistenteia engine pull turboderp/Qwen3.5-9B-exl3 3.00bpw)"
                            echo "Contexto:         $HERMES_CTX (caché $HERMES_CACHE_MODE)"
                            if ai_needs_tabby; then
                                ai_tabby_up && echo "Sidecar:          EN MARCHA ($EXLLAMA_BASE_URL)" \
                                            || echo "Sidecar:          detenido"
                            fi
                        fi
                        if ai_hermes_tts_enabled; then
                            echo "TTS Hermes:       ACTIVADO"
                        else
                            echo "TTS Hermes:       desactivado (asistenteia engine hermes tts on)"
                        fi
                        echo "Tools de Luka:    $(ai_luka_mcp_url)"
                        exit 0 ;;
                    "") : ;;   # sin subcomando: sigue al cambio de motor de abajo
                    *) err "Subcomando no válido: 'engine hermes ${2}'. Usa: model | fallback | install | status | tts"; exit 1 ;;
                esac
                ;;
        esac

        case "$sub" in
            openrouter)
                orsub="${2:-}"
                case "$orsub" in
                    key)
                        # La key vive SOLO en el .env, que está en .gitignore. El chmod es
                        # porque ahí dentro también hay API_TOKEN y no tiene por qué leerlo
                        # cualquier proceso de la máquina.
                        newkey="${3:-}"
                        if [ -z "$newkey" ]; then
                            echo "API key de OpenRouter: $(ai_openrouter_key_masked)"
                            echo "Uso: asistenteia engine openrouter key <TU_API_KEY>"
                            echo "Consíguela en https://openrouter.ai/keys (los modelos de la lista son gratis)."
                            exit 0
                        fi
                        ai_set_env_key OPENROUTER_API_KEY "$newkey"
                        chmod 600 "$PROJECT_DIR/.env" 2>/dev/null || true
                        ok "API key guardada en $PROJECT_DIR/.env ($(ai_openrouter_key_masked))."
                        if ai_using_openrouter && ai_server_up; then
                            echo "Reinicia para aplicarla: asistenteia restart"
                        fi
                        exit 0 ;;
                    status|"")
                        # Sin subcomando: estado. Cambiar de motor es 'asistenteia engine openrouter'
                        # sin más, que cae más abajo (fuera de este case).
                        if [ -n "$orsub" ]; then
                            echo "Motor actual:  $cur"
                            echo "Modelo:        $(ai_openrouter_model)"
                            echo "Visión:        $(ai_read_env OPENROUTER_VISION True)"
                            echo "Reserva:       $(ai_openrouter_fallbacks)"
                            echo "API key:       $(ai_openrouter_key_masked)"
                            exit 0
                        fi
                        ;;
                    model)
                        cur_model="$(ai_openrouter_model)"
                        key="${3:-}"
                        if [ -z "$key" ] || [ "$key" = list ] || [ "$key" = status ]; then
                            echo "Modelo OpenRouter actual: $cur_model"
                            echo
                            echo "Modelos GRATIS con herramientas (los de pago no se ofrecen):"
                            i=0; ids=""
                            while IFS='|' read -r mid mname mctx mvis; do
                                [ -z "$mid" ] && continue
                                i=$((i + 1)); ids="$ids $mid"
                                mark=" "; [ "$mid" = "$cur_model" ] && mark="*"
                                [ "$mvis" = yes ] && vis="VISIÓN" || vis="  —   "
                                printf "  %s %2d) %-52s %s  %6s ctx\n" "$mark" "$i" "$mid" "$vis" "$((mctx / 1000))k"
                            done < <(ai_openrouter_models --list)
                            if [ "$i" -eq 0 ]; then err "No se pudo obtener el catálogo."; exit 1; fi
                            echo
                            echo "VISIÓN = puede mirar por la cámara y analizar la pantalla."
                            [ "$key" = list ] || [ "$key" = status ] && exit 0
                            if [ -r /dev/tty ]; then
                                read -r -p "¿Qué modelo uso? [nº o id] (Enter = cancelar): " key </dev/tty || key=""
                            fi
                            [ -z "$key" ] && { echo "Sin cambios."; exit 0; }
                            # Permitir elegir por número de la lista.
                            case "$key" in
                                ''|*[!0-9]*) : ;;
                                *) key="$(echo $ids | cut -d' ' -f"$key")" ;;
                            esac
                        fi
                        if ! vision="$(ai_openrouter_models --check "$key")"; then
                            err "'$key' no está entre los modelos gratis con herramientas."
                            err "Míralos con: asistenteia engine openrouter model list"
                            exit 1
                        fi
                        ai_set_env_key OPENROUTER_MODEL "$key"
                        if [ "$vision" = yes ]; then
                            ai_set_env_key OPENROUTER_VISION True
                            echo "Modelo OpenRouter activo: $key (con visión)"
                        else
                            ai_set_env_key OPENROUTER_VISION False
                            warn "'$key' no acepta imágenes: la cámara y el análisis de pantalla no funcionarán con él."
                        fi
                        if [ "$(ai_engine)" != openrouter ]; then
                            warn "El motor activo es '$(ai_engine)'. Úsalo con: asistenteia engine openrouter"
                            exit 0
                        fi
                        if ai_server_up; then
                            echo "Reiniciando para cargar '$key'..."
                            "$SCRIPTS_DIR/stop-assistant.sh" >/dev/null 2>&1 || true
                            sleep 1
                            case "$(ai_ensure_running 60)" in
                                error) err "No arrancó con '$key'. Revisa: asistenteia logs"; exit 1 ;;
                                *)     echo "Listo: '$key' en uso." ;;
                            esac
                        else
                            echo "Hecho. Se usará al arrancar (asistenteia start o Super + Z)."
                        fi
                        exit 0 ;;
                    *)
                        err "Subcomando desconocido: engine openrouter $orsub"
                        echo "Usa: model | key | status"; exit 1 ;;
                esac
                ;;
        esac

        # Subcomandos auxiliares del sidecar TabbyAPI (instalación / control manual).
        case "$sub" in
            install)
                exec bash "$SCRIPTS_DIR/install-exllama.sh" "${@:2}" ;;
            start)
                ai_tabby_start 180 || { err "No se pudo arrancar TabbyAPI."; exit 1; }
                exit 0 ;;
            stop)
                ai_tabby_stop; echo "Sidecar TabbyAPI detenido."; exit 0 ;;
            model)
                # Gestiona el MODELO del motor exllama (catálogo qwen3-8b / qwen3-vl):
                # lo descarga si falta, ajusta .env (EXLLAMA_MODEL/VISION) y config.yml,
                # y reinicia. Análogo a 'asistenteia model' para LiteRT.
                key="${2:-}"
                cur_model="$(ai_read_env EXLLAMA_MODEL Qwen3-8B-exl3-4bpw)"
                if [ -z "$key" ] || [ "$key" = list ] || [ "$key" = status ]; then
                    echo "Modelo exllama actual: $cur_model"
                    echo; echo "Disponibles:"
                    for k in $EXLLAMA_MODEL_KEYS; do
                        IFS='|' read -r _r _v dir vis _s desc < <(exllama_model_meta "$k")
                        est="no descargado"; ai_tabby_model_present "$dir" && est="descargado"
                        mark=" "; [ "$dir" = "$cur_model" ] && mark="*"
                        printf "  %s %-9s %-26s [%s]\n" "$mark" "$k" "$desc" "$est"
                    done
                    exit 0
                fi
                if ! meta="$(exllama_model_meta "$key")"; then
                    err "Modelo exllama no válido: '$key'. Usa: $EXLLAMA_MODEL_KEYS"; exit 1
                fi
                IFS='|' read -r repo rev dir vis seq desc <<<"$meta"
                if ! ai_tabby_installed; then
                    err "El backend exllama no está instalado. Ejecuta: asistenteia engine install"; exit 1
                fi
                if ai_tabby_model_present "$dir"; then
                    echo "Modelo '$key' ya descargado."
                else
                    echo "Descargando '$key' ($repo@$rev)... (varios GB)"
                    ai_tabby_download_model "$repo" "$rev" "$dir" || { err "La descarga falló."; exit 1; }
                fi
                ai_set_env_key EXLLAMA_MODEL "$dir"
                [ "$vis" = yes ] && ai_set_env_key EXLLAMA_VISION True || ai_set_env_key EXLLAMA_VISION False
                ai_refresh_focus_tools
                ai_tabby_write_config "$dir" "$seq" "$vis"
                echo "Modelo exllama activo: $dir (visión: $vis)"
                if [ "$(ai_engine)" != exllama ]; then
                    warn "El motor activo es '$(ai_engine)'. Úsalo con: asistenteia engine exllama"
                    exit 0
                fi
                if ai_server_up; then
                    echo "Reiniciando para cargar '$key'..."
                    "$SCRIPTS_DIR/stop-assistant.sh" >/dev/null 2>&1 || true
                    sleep 1
                    case "$(ai_ensure_running 240)" in
                        error) err "No arrancó con '$key'. Revisa: asistenteia logs"; exit 1 ;;
                        *)     echo "Listo: '$key' cargado." ;;
                    esac
                else
                    echo "Hecho. Se cargará al arrancar (asistenteia start o Super + Z)."
                fi
                exit 0 ;;
            thinking)
                # Activa/desactiva el razonamiento <think> de Qwen3 (solo exllama):
                # mejores respuestas a costa de latencia y tokens. Ajusta EXLLAMA_THINKING.
                val="${2:-}"
                case "$(printf '%s' "$(ai_read_env EXLLAMA_THINKING False)" | tr 'A-Z' 'a-z')" in
                    true|1|yes|on) cur_on=1 ;; *) cur_on=0 ;;
                esac
                if [ -z "$val" ] || [ "$val" = status ]; then
                    [ "$cur_on" = 1 ] && echo "Razonamiento (exllama): ACTIVADO" \
                                      || echo "Razonamiento (exllama): desactivado"
                    echo "Uso: asistenteia engine thinking on|off"
                    exit 0
                fi
                case "$(printf '%s' "$val" | tr 'A-Z' 'a-z')" in
                    on|true|1|yes|si|sí) new_on=1; new_val=True ;;
                    off|false|0|no)      new_on=0; new_val=False ;;
                    *) err "Valor no válido: '$val'. Usa on u off."; exit 1 ;;
                esac
                if [ "$new_on" = "$cur_on" ]; then
                    echo "El razonamiento ya está $([ "$new_on" = 1 ] && echo activado || echo desactivado). Nada que hacer."
                    exit 0
                fi
                ai_set_env_key EXLLAMA_THINKING "$new_val"
                [ "$new_on" = 1 ] && echo "Razonamiento activado." || echo "Razonamiento desactivado."
                if [ "$new_on" = 1 ]; then
                    warn "Subirá la latencia y el consumo de tokens. Si las respuestas se cortan,"
                    warn "sube EXLLAMA_MAX_TOKENS en el .env (ahora $(ai_read_env EXLLAMA_MAX_TOKENS 1024))."
                fi
                if [ "$(ai_engine)" != exllama ]; then
                    warn "El motor activo es '$(ai_engine)': el razonamiento solo aplica a exllama."
                    echo "Se aplicará al cambiar de motor: asistenteia engine exllama"
                    exit 0
                fi
                if ai_server_up; then
                    echo "Reiniciando para aplicar..."
                    "$SCRIPTS_DIR/stop-assistant.sh" >/dev/null 2>&1 || true
                    sleep 1
                    case "$(ai_ensure_running 240)" in
                        error) err "No arrancó. Revisa: asistenteia logs"; exit 1 ;;
                        *)     echo "Listo." ;;
                    esac
                else
                    echo "Hecho. Se aplicará al arrancar (asistenteia start o Super + Z)."
                fi
                exit 0 ;;
            tts|hermes-tts)
                ai_hermes_tts_cmd "${2:-}" ;;
            browse)
                # Explora los modelos de turboderp (creador de ExLlama) en HuggingFace.
                # Solo lectura (necesita Internet); no descarga ni instala nada.
                # Filtro opcional para acotar (substring sobre el id del repo).
                filt="${2:-}"
                echo "Modelos de ${C_CYAN}turboderp${C_RESET} en HuggingFace${filt:+ (filtro: $filt)}:"
                echo "(ordenados por descargas; 'exl3' es el formato del motor exllama)"
                echo
                if ! rows="$(ai_hf_author_models turboderp "$filt" 2>&1)"; then
                    err "$rows"; exit 1
                fi
                if [ -z "$rows" ]; then
                    echo "  (sin resultados${filt:+ para '$filt'})"; exit 0
                fi
                printf '%s\n' "$rows" | while IFS=$'\t' read -r dl id; do
                    printf "  %8s ↓  %s\n" "$dl" "$id"
                done
                echo
                echo "Descargar uno:  asistenteia engine pull <repo> [bpw]"
                echo "Ej.:            asistenteia engine pull turboderp/Qwen3-8B-exl3 6.0bpw"
                echo "Para código/razonamiento, busca un *Coder* o un Qwen3 grande que te quepa en VRAM."
                exit 0 ;;
            pull)
                # Descarga CUALQUIER modelo EXL3 (recomendado: de turboderp) a la carpeta
                # de modelos de TabbyAPI, sin tocar el catálogo curado. En EXL3 cada bpw
                # (cuantización) es una rama: sin indicar una, te enseña las disponibles.
                repo="${2:-}"; rev="${3:-}"
                if [ -z "$repo" ]; then
                    err "Uso: asistenteia engine pull <repo> [revision/bpw]"
                    err "Ej.: asistenteia engine pull turboderp/Qwen3-8B-exl3 6.0bpw"
                    err "Ver disponibles: asistenteia engine browse"
                    exit 1
                fi
                if ! ai_tabby_installed; then
                    err "El backend exllama no está instalado. Ejecuta: asistenteia engine install"; exit 1
                fi
                # Atajo cómodo: 'Qwen3-8B-exl3' -> 'turboderp/Qwen3-8B-exl3'.
                case "$repo" in */*) : ;; *) repo="turboderp/$repo" ;; esac

                if [ -z "$rev" ]; then
                    echo "Revisiones (cuantizaciones bpw) de $repo — tamaño y si cabe en tu VRAM:"
                    echo "(VRAM total de la tarjeta, asumiéndola limpia y dedicada al LLM)"
                    if ! revs="$(ai_hf_repo_revisions_sized "$repo" 2>&1)"; then
                        err "$revs"; exit 1
                    fi
                    printf '%s\n' "$revs" | while IFS=$'\t' read -r rname rmib; do
                        case "$rmib" in
                            0) continue ;;  # rama sin pesos (p.ej. 'main' con solo README)
                            "") printf "  %-14s   (tamaño n/d)\n" "$rname" ;;
                            *)  printf "  %-14s %5s MiB  %s\n" "$rname" "$rmib" "$(ai_vram_verdict "$rmib")" ;;
                        esac
                    done
                    echo
                    if [ -r /dev/tty ]; then
                        read -r -p "¿Qué revisión descargar? (Enter = cancelar): " rev </dev/tty || rev=""
                    fi
                    [ -z "$rev" ] && { echo "Sin descargar."; exit 0; }
                fi

                # Nombre de carpeta determinista: <repo-base>[-<rev>] (sin sufijo si es main).
                base="${repo##*/}"
                case "$rev" in main|"") dir="$base"; rev=main ;; *) dir="$base-$rev" ;; esac

                # Aviso de encaje en VRAM (no bloquea: solo informa).
                psz="$(ai_hf_repo_size_mib "$repo" "$rev")"
                [ -n "$psz" ] && echo "VRAM: $(ai_vram_verdict "$psz")"

                if ai_tabby_model_present "$dir"; then
                    echo "Ya estaba descargado: models/$dir"
                else
                    echo "Descargando $repo@$rev -> models/$dir (varios GB, puede tardar)..."
                    ai_tabby_download_model "$repo" "$rev" "$dir" \
                        || { err "La descarga falló."; exit 1; }
                    ok "Descargado: models/$dir"
                fi
                echo
                if ai_confirm "¿Activarlo ahora (engine use $dir)?"; then
                    exec "$SELF" engine use "$dir"
                fi
                echo "Cuando quieras usarlo: asistenteia engine use $dir"
                exit 0 ;;
            use)
                # Activa un modelo EXL3 YA descargado (del catálogo o traído con 'pull'):
                # escribe el config.yml del sidecar y fija EXLLAMA_MODEL. Funcione o no
                # como asistente (depende de si soporta tools), TabbyAPI lo sirve igual
                # en /v1 para herramientas externas. Opciones: --vision, --ctx N.
                name="${2:-}"; want_vision=no; ctx=""
                args=("${@:3}"); i=0
                while [ "$i" -lt "${#args[@]}" ]; do
                    case "${args[$i]}" in
                        --vision)    want_vision=yes ;;
                        --ctx|--ctx=*) [ "${args[$i]}" = --ctx ] && { i=$((i+1)); ctx="${args[$i]:-}"; } || ctx="${args[$i]#*=}" ;;
                        *)           warn "Opción ignorada: ${args[$i]}" ;;
                    esac
                    i=$((i+1))
                done

                cur_model="$(ai_read_env EXLLAMA_MODEL Qwen3-8B-exl3-4bpw)"
                if [ -z "$name" ] || [ "$name" = list ] || [ "$name" = status ]; then
                    echo "Modelos EXL3 descargados (en $EXLLAMA_TABBY_DIR/models):"
                    found=0
                    while IFS= read -r d; do
                        [ -z "$d" ] && continue
                        found=1; mark=" "; [ "$d" = "$cur_model" ] && mark="*"
                        printf "  %s %s\n" "$mark" "$d"
                    done < <(ai_tabby_list_downloaded)
                    [ "$found" = 0 ] && echo "  (ninguno; descarga con: asistenteia engine pull ...)"
                    echo
                    echo "Activar uno:  asistenteia engine use <nombre> [--vision] [--ctx N]"
                    exit 0
                fi

                if ! ai_tabby_model_present "$name"; then
                    err "No hay un modelo descargado llamado '$name'."
                    err "Ver descargados: asistenteia engine use   ·   Descargar: asistenteia engine pull ..."
                    exit 1
                fi

                # Por defecto: texto, 8192 de contexto. Si el nombre coincide con el
                # catálogo curado, heredamos su visión/contexto ya validados para 8 GiB.
                def_seq=8192; def_vis=no
                for k in $EXLLAMA_MODEL_KEYS; do
                    IFS='|' read -r _r _v cdir cvis cseq _d < <(exllama_model_meta "$k")
                    [ "$cdir" = "$name" ] && { def_seq="$cseq"; def_vis="$cvis"; }
                done
                [ -n "$ctx" ] || ctx="$def_seq"
                [ "$want_vision" = yes ] || want_vision="$def_vis"
                case "$ctx" in ''|*[!0-9]*) err "Contexto no válido: '$ctx'."; exit 1 ;; esac

                # Aviso de encaje en VRAM total de la tarjeta (no bloquea: solo informa).
                dsz="$(ai_dir_size_mib "$name")"
                [ "${dsz:-0}" -gt 0 ] && echo "VRAM: $(ai_vram_verdict "$dsz")"

                ai_tabby_write_config "$name" "$ctx" "$want_vision"
                ai_set_env_key EXLLAMA_MODEL "$name"
                # Se guarda para que al ir y volver de 'hermes' (que reescribe el
                # config.yml con su propio perfil) se recupere ESTA ventana, incluida
                # una elegida a mano con --ctx, y no la del catálogo.
                ai_set_env_key EXLLAMA_CTX "$ctx"
                [ "$want_vision" = yes ] && ai_set_env_key EXLLAMA_VISION True || ai_set_env_key EXLLAMA_VISION False
                ai_refresh_focus_tools
                ok "Modelo exllama activo: $name (contexto $ctx, visión: $want_vision)"
                warn "Si el modelo no soporta 'tools', el asistente puede no manejarlo bien;"
                warn "pero TabbyAPI lo sirve igual en $EXLLAMA_BASE_URL/v1 para herramientas externas."

                if [ "$(ai_engine)" != exllama ]; then
                    echo
                    echo "El motor del asistente es '$(ai_engine)'. Para usar este modelo:"
                    echo "  • en el propio asistente:        asistenteia engine exllama"
                    echo "  • solo para apps externas:        asistenteia engine start"
                    exit 0
                fi
                if ai_server_up; then
                    echo "Reiniciando para cargar '$name'..."
                    "$SCRIPTS_DIR/stop-assistant.sh" >/dev/null 2>&1 || true
                    sleep 1
                    case "$(ai_ensure_running 240)" in
                        error) err "No arrancó con '$name'. Revisa: asistenteia logs"; exit 1 ;;
                        *)     ok "Listo: '$name' cargado." ;;
                    esac
                else
                    echo "Hecho. Se cargará al arrancar (asistenteia start o Super + Z)."
                fi
                exit 0 ;;
        esac

        # Sin argumento (o list/status): mostrar el motor actual y los disponibles.
        if [ -z "$sub" ] || [ "$sub" = list ] || [ "$sub" = status ]; then
            echo "Motor actual: $cur"
            echo
            echo "Disponibles:"
            m=" "; [ "$cur" = litert ] && m="*"
            printf "  %s litert   LiteRT-LM (Gemma, en proceso, audio+visión)  [%s]\n" "$m" "instalado"
            m=" "; [ "$cur" = exllama ] && m="*"
            est="no instalado"; ai_tabby_installed && est="instalado"
            printf "  %s exllama  ExLlamaV3 vía TabbyAPI (Qwen3, sidecar GPU)  [%s]\n" "$m" "$est"
            m=" "; [ "$cur" = openrouter ] && m="*"
            est="sin API key"; [ -n "$(ai_openrouter_key)" ] && est="con API key"
            printf "  %s openrouter  LLM en la nube (gratis, sin VRAM)          [%s]\n" "$m" "$est"
            m=" "; [ "$cur" = hermes ] && m="*"
            if ai_hermes_use_openrouter; then
                est="OpenRouter: $(ai_hermes_model)"
            else
                est="modelo sin descargar"; ai_tabby_model_present "$HERMES_MODEL" && est="listo"
            fi
            printf "  %s hermes   Hermes Agent agéntico (64k+, tools)       [%s]\n" "$m" "$est"
            echo
            if ai_needs_tabby; then
                ai_tabby_up && echo "Sidecar TabbyAPI: EN MARCHA ($EXLLAMA_BASE_URL)" \
                            || echo "Sidecar TabbyAPI: detenido"
            fi
            if ai_using_openrouter; then
                echo "Modelo OpenRouter: $(ai_openrouter_model)"
            fi
            if ai_using_hermes; then
                if ai_hermes_use_openrouter; then
                    echo "Modelo Hermes: $(ai_hermes_model) (OpenRouter)"
                else
                    echo "Modelo Hermes: $HERMES_MODEL (Local GPU)"
                fi
            fi
            [ "$sub" = list ] || [ "$sub" = status ] && exit 0
            echo
            if [ -r /dev/tty ]; then
                read -r -p "¿A qué motor cambiar? [litert/exllama/openrouter/hermes] (Enter = cancelar): " sub </dev/tty || sub=""
            fi
            [ -z "$sub" ] && { echo "Sin cambios."; exit 0; }
        fi

        sub="$(printf '%s' "$sub" | tr 'A-Z' 'a-z')"
        case "$sub" in
            litert|exllama|openrouter|hermes) : ;;
            *) err "Motor no válido: '$sub'. Usa litert, exllama, openrouter o hermes."; exit 1 ;;
        esac

        if [ "$sub" = "$cur" ]; then
            echo "Ya estás usando el motor '$sub'. Nada que hacer."
            exit 0
        fi

        # exllama necesita su backend instalado (venv + TabbyAPI + modelo EXL3).
        if [ "$sub" = exllama ] && ! ai_tabby_installed; then
            warn "El backend ExLlama no está instalado en $EXLLAMA_TABBY_DIR."
            warn "Instálalo primero con: asistenteia engine install"
            if ! ai_confirm "¿Cambiar a 'exllama' igualmente (no arrancará hasta instalarlo)?"; then
                echo "Sin cambios."; exit 0
            fi
        fi

        # OpenRouter sin key arranca pero no puede responder: mejor avisar aquí que
        # descubrirlo hablándole al asistente.
        if [ "$sub" = openrouter ] && [ -z "$(ai_openrouter_key)" ]; then
            warn "No hay API key de OpenRouter configurada."
            warn "Ponla con: asistenteia engine openrouter key <TU_API_KEY>"
            if ! ai_confirm "¿Cambiar a 'openrouter' igualmente (no responderá hasta ponerla)?"; then
                echo "Sin cambios."; exit 0
            fi
        fi

        # hermes necesita su propia instalación (clon + venv), aparte del sidecar.
        if [ "$sub" = hermes ] && ! ai_hermes_installed; then
            warn "Hermes no está instalado en $(ai_hermes_dir)."
            warn "Instálalo primero con: asistenteia engine hermes install"
            if ! ai_confirm "¿Cambiar a 'hermes' igualmente (no responderá hasta instalarlo)?"; then
                echo "Sin cambios."; exit 0
            fi
        fi

        ai_set_env_key AI_ENGINE "$sub"
        ai_refresh_focus_tools
        echo "Motor activo: $sub"
        [ "$sub" = openrouter ] && echo "Modelo: $(ai_openrouter_model)"
        if [ "$sub" = hermes ]; then
            ai_hermes_sync_config
            if ai_hermes_use_openrouter; then
                echo "Modelo Hermes: $(ai_hermes_model) (OpenRouter)"
                if [ -z "$(ai_openrouter_key)" ]; then
                    warn "No hay API key de OpenRouter configurada en .env."
                    warn "Ponla con: asistenteia engine openrouter key <TU_API_KEY>"
                fi
            else
                echo "Modelo Hermes: $HERMES_MODEL (Local GPU)"
            fi
        fi

        # exllama y hermes local comparten sidecar pero NO configuración: uno quiere la ventana
        # corta de Luka y el otro 64k para el bucle de Hermes. Al cambiar entre ellos hay
        # que reescribir el config.yml, o el sidecar arrancaría con el perfil del otro.
        if ai_needs_tabby; then
            if ai_tabby_sync_config_for_engine; then
                if [ "$sub" = hermes ] && ! ai_hermes_use_openrouter; then
                    echo "Sidecar: $HERMES_MODEL (contexto $HERMES_CTX, caché $HERMES_CACHE_MODE)"
                fi
            else
                warn "El modelo del motor '$sub' no está descargado; el config.yml no se ha tocado."
                [ "$sub" = hermes ] && \
                    warn "Descárgalo con: asistenteia engine pull turboderp/Qwen3.5-9B-exl3 3.00bpw"
            fi
        fi

        # Mutua exclusión: al salir de exllama/hermes local, parar el sidecar y liberar VRAM.
        if ! ai_needs_tabby; then
            ai_tabby_stop
        fi

        # Al dejar de ser el motor activo, Hermes se apaga entero: el puente y cualquier
        # Hermes suelto que hubiera abierto en una terminal. Si no, se quedaría un agente
        # cargado, ejecutando herramientas, cuando el usuario ya ha cambiado de motor —
        # y además apuntando a un sidecar que puede haberse parado o cambiado de perfil.
        if [ "$cur" = hermes ] && [ "$sub" != hermes ]; then
            ai_hermes_stop
            echo "Hermes detenido (puente y sesiones de terminal)."
        fi

        # Aplicar reiniciando (igual que 'model'); ai_ensure_running levanta el
        # sidecar si toca. Timeout amplio: TabbyAPI carga el modelo al arrancar.
        if ai_server_up; then
            echo "Reiniciando para aplicar el motor '$sub'..."
            "$SCRIPTS_DIR/stop-assistant.sh" >/dev/null 2>&1 || true
            sleep 1
            case "$(ai_ensure_running 180)" in
                error) err "No arrancó con el motor '$sub'. Revisa: asistenteia logs"; exit 1 ;;
                *)     echo "Listo: asistente en marcha con el motor '$sub'." ;;
            esac
        else
            echo "Hecho. Se aplicará al arrancar (asistenteia start o Super + Z)."
        fi
        ;;
    hermes)
        case "${1:-}" in
            model)
                ai_hermes_model_cmd "${2:-}" ;;
            fallback)
                ai_hermes_fallback_cmd "${2:-}" ;;
            tts)
                ai_hermes_tts_cmd "${2:-}" ;;
        esac
        # Hermes SUELTO en la terminal, al margen de la voz. Comparte el mismo modelo
        # local y, si el asistente está en marcha, sus mismas herramientas (el servidor
        # MCP vive dentro de ese proceso). Todo lo que venga detrás se le pasa tal cual:
        #   asistenteia hermes                  -> chat interactivo (su TUI)
        #   asistenteia hermes -z "pausa la música"  -> una pregunta y su respuesta
        if ! ai_hermes_installed; then
            err "Hermes no está instalado. Ponlo con: asistenteia engine hermes install"; exit 1
        fi
        if ! ai_tabby_up; then
            warn "El sidecar TabbyAPI no responde en $EXLLAMA_BASE_URL: Hermes no tendrá modelo."
            warn "Arráncalo con: asistenteia engine start"
        fi
        if ! ai_server_up; then
            warn "El asistente no está en marcha, así que Hermes irá SIN las herramientas"
            warn "de Luka (pantalla, música, correo...): las sirve su propio proceso."
        fi
        cd "$(ai_hermes_dir)" || { err "No se pudo entrar en $(ai_hermes_dir)."; exit 1; }
        exec "$(ai_hermes_dir)/.venv/bin/hermes" "$@"
        ;;
    google-auth)
        # Alta interactiva del token OAuth de Google (abre el navegador una vez).
        # Se ejecuta desde PROJECT_DIR para que 'src' sea importable con -m.
        ( cd "$PROJECT_DIR" && "$PROJECT_DIR/venv/bin/python" -m src.integrations.google.auth )
        ;;
    update)
        if [ -d "$PROJECT_DIR/.git" ]; then
            git -C "$PROJECT_DIR" pull --ff-only || { err "No se pudo actualizar."; exit 1; }
        fi
        "$PROJECT_DIR/venv/bin/pip" install -r "$PROJECT_DIR/requirements.txt"
        echo "AsistenteIA actualizado."
        ;;
    uninstall)
        exec bash "$PROJECT_DIR/uninstall.sh"
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        err "Comando desconocido: $cmd"
        usage
        exit 1
        ;;
esac
