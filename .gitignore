!models/sherpa-kws/
models/sherpa-kws/*
!models/sherpa-kws/encoder.onnx
!models/sherpa-kws/decoder.onnx
!models/sherpa-kws/joiner.onnx
!models/sherpa-kws/bpe.model
!models/sherpa-kws/tokens.txt
!models/sherpa-kws/keywords.txt

