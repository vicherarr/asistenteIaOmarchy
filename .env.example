# Configuración de Ejemplo - AsistenteIA

# API Server
HOST=127.0.0.1
PORT=8765
DEBUG=False

# --- LITE RT MODELS ---
# El asistente usa por defecto: models/gemma-4-e2b.litertlm
LITERT_MODEL_PATH=models/gemma-4-e2b.litertlm

# Assistant Settings
MAX_HISTORY=5

# --- TTS SETTINGS (KOKORO) ---
# Idiomas: 'e' (Español), 'a' (American), 'b' (British)
KOKORO_LANG=e

# VOCES DISPONIBLES:
# Español Hombre:
# - em_alex  (Voz joven/profesional, también llamada Mateo)
# - em_santa (Voz profunda y cálida)
# Español Mujer:
# - ef_dora  (Voz femenina clara y expresiva)

# Inglés (Ejemplos populares):
# - af_heart (Femenina, alta calidad)
# - af_bella (Femenina, suave)
# - am_adam  (Masculina, natural)
# - bf_emma  (Femenina, acento británico)

KOKORO_VOICE=em_alex

# --- WAKE WORD SETTINGS ---
# Activar o desactivar la escucha por palabra de activación (True/False)
WAKE_WORD_ENABLED=True
# Palabra de activación: 'hey_jarvis', 'hey_mycroft', etc.
WAKE_WORD_MODEL=hey_jarvis
# Umbral de precisión (0.0 a 1.0)
WAKE_WORD_THRESHOLD=0.5

# --- STT SETTINGS (Whisper / whisper-cli en CPU) ---
# Modelo de transcripción. Usa ruta absoluta (~ no se expande).
#   Preciso (~6s, robusto en micro BT): ggml-large-v3-turbo.bin
#   Rápido  (~2.4s, frágil en audio degradado): ggml-small.bin
#   [EXPERIMENTAL] ggml-medium.bin               (~6s, intermedio)
#   [EXPERIMENTAL] ggml-large-v3-turbo-q8_0.bin  (~5.7s, turbo cuantizado q8)
#   [EXPERIMENTAL] ggml-large-v3-turbo-q5_0.bin  (~5.7s, turbo cuantizado q5)
STT_MODEL_PATH=/home/usuario/.cache/whisper/ggml-large-v3-turbo.bin
# Idioma de la transcripción
STT_LANGUAGE=es
# Hilos de CPU para whisper-cli (sube hasta nº de núcleos físicos)
STT_THREADS=8
# Prompt inicial que sesga el reconocimiento hacia tu vocabulario (opcional)
# STT_PROMPT=Comandos de voz en español para el asistente Luka...

# --- SEGURIDAD Y CIFRADO ---
# Token de acceso para la API y la interfaz web. Dejar vacío para desactivar autenticación en desarrollo local.
API_TOKEN=un_secreto_seguro
# Rutas de los certificados SSL/TLS para habilitar HTTPS. Dejar vacío para usar HTTP plano.
SSL_KEYFILE=config/certs/key.pem
SSL_CERTFILE=config/certs/cert.pem

