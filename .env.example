# Configuración de Ejemplo - AsistenteIA
# Copia este archivo a .env y ajusta lo que necesites.
# El instalador genera un .env automáticamente con un API_TOKEN seguro.

# --- API SERVER ---
HOST=127.0.0.1
PORT=8765
DEBUG=False

# --- MODELO LITERT (LLM principal: Gemma 4 E4B) ---
# Ruta relativa a la raíz del proyecto. El instalador lo descarga de HuggingFace.
LITERT_MODEL_PATH=models/gemma-4-E4B-it.litertlm
# Backend de inferencia: gpu | cpu | auto
LITERT_BACKEND=gpu
# Timeout (segundos) de la inferencia del modelo
LITERT_TIMEOUT=35.0

# --- ASISTENTE ---
# Nº de turnos de conversación que se recuerdan
MAX_HISTORY=10

# --- TTS (KOKORO) ---
# Idiomas: 'e' (Español), 'a' (American English), 'b' (British English)
KOKORO_LANG=e
# VOCES DISPONIBLES:
#   Español hombre: em_alex (joven/profesional), em_santa (profunda y cálida)
#   Español mujer:  ef_dora (clara y expresiva)
#   Inglés:         af_heart, af_bella, am_adam, bf_emma
KOKORO_VOICE=em_alex

# --- STT (RECONOCIMIENTO DE VOZ) ---
# Por defecto se usa el audio nativo de Gemma (un solo modelo multimodal).
# Pon STT_USE_GEMMA_AUDIO=False para usar faster-whisper en su lugar.
STT_USE_GEMMA_AUDIO=False
# Ajustes de faster-whisper (solo aplican si STT_USE_GEMMA_AUDIO=False):
# Modelo: large-v3-turbo, large-v3, medium, small... o ruta a un modelo CT2.
STT_MODEL=large-v3-turbo
# Dispositivo: cpu (la GPU requiere VRAM libre y CUDA 12 + cuDNN 9)
STT_DEVICE=cpu
# Cuantización (CPU): int8 (máx. velocidad) | int16 (intermedio) | float32 (máx. calidad)
STT_COMPUTE_TYPE=int8
# Idioma de la transcripción
STT_LANGUAGE=es
# Hilos de CPU (sube hasta el nº de núcleos físicos)
STT_THREADS=8
# VAD Silero: recorta silencios y evita alucinaciones
STT_VAD=True
# Prompt inicial que sesga el reconocimiento hacia tu vocabulario (opcional)
# STT_PROMPT=Comandos de voz en español para el asistente Luka...

# --- WAKE WORD (Sherpa-ONNX KWS) ---
# Activar/desactivar la escucha por palabra de activación ("LUKA")
WAKE_WORD_ENABLED=True
# Archivos del modelo (incluidos en el repositorio, rutas relativas a la raíz)
WAKE_WORD_KEYWORDS_FILE=models/sherpa-kws/keywords.txt
WAKE_WORD_MODEL_DIR=models/sherpa-kws
# Umbral de detección (0.0 a 1.0). Más bajo = más sensible.
WAKE_WORD_THRESHOLD=0.10

# --- SEGURIDAD Y CIFRADO ---
# Token de acceso para la API y la interfaz web. El instalador genera uno seguro.
# Déjalo vacío para desactivar la autenticación (solo desarrollo local).
API_TOKEN=
# Rutas de los certificados SSL/TLS para HTTPS (relativas a la raíz del proyecto).
# Déjalas vacías para usar HTTP plano. El instalador genera certificados autofirmados.
SSL_KEYFILE=config/certs/key.pem
SSL_CERTFILE=config/certs/cert.pem
