# Configuración de Ejemplo - AsistenteIA
# Copia este archivo a .env y ajusta lo que necesites.
# El instalador genera un .env automáticamente con un API_TOKEN seguro.

# --- API SERVER ---
HOST=127.0.0.1
PORT=8765
DEBUG=False

# --- MODELO LITERT (LLM principal: Gemma 4 E4B) ---
# Ruta relativa a la raíz del proyecto. El instalador lo descarga de HuggingFace.
LITERT_MODEL_PATH=models/gemma-4-E4B-it.litertlm
# Backend de inferencia: gpu | cpu | auto
LITERT_BACKEND=gpu
# Timeout (segundos) de la inferencia del modelo
LITERT_TIMEOUT=35.0
# Multi-Token Prediction (MTP): hasta 2.2x decode en GPU, recomendado para E4B.
# Ponlo en False solo si en CPU notas penalti en generación libre.
LITERT_SPECULATIVE_DECODING=True
# Caché de artefactos compilados (acelera el arranque en frío).
# Vacío => ~/.cache/asistenteia/litert
LITERT_CACHE_DIR=
# Pasar el system prompt como hint para mejorar el TTFT del primer turno
LITERT_PROMPT_HINT=True
# --- Fase 2: muestreo (SamplerConfig) ---
# El modelo viene afinado en GREEDY (top_k=1), lo más fiable para tool-calling y
# visión. Por eso NO se impone sampler por defecto. Pon True solo para experimentar
# con texto más variado (puede volver menos fiables las llamadas a herramientas).
LITERT_SAMPLER_ENABLED=False
# Perfil de "charla" (solo aplica con LITERT_SAMPLER_ENABLED=True y sin tools/imagen):
LITERT_TEMPERATURE=0.6
LITERT_TOP_K=64
LITERT_TOP_P=0.95
LITERT_SEED=-1
# --- Fase 3: conversación persistente con KV-cache (EXPERIMENTAL) ---
# True = mantiene una conversación viva entre turnos (no re-prefilla el historial).
LITERT_PERSISTENT_CONVERSATION=False
# --- Fase 4: eventos de tool al log + gating opcional (EXPERIMENTAL) ---
# El registro de qué tools se ejecutan está SIEMPRE activo (lo necesita el guardarraíl
# anti-invención); esto solo añade al log el nombre y los argumentos de cada llamada.
LITERT_TOOL_EVENTS=False
# Fuerza tool calls sintácticamente válidas (evita "Failed to parse FC tool calls").
# EXPERIMENTAL: mídelo con scripts/spike-constrained-decoding.py antes de activarlo.
LITERT_CONSTRAINED_DECODING=False

# --- MOTOR DE INFERENCIA ---
# "litert" (por defecto, Gemma en proceso), "exllama" (Qwen3 en sidecar TabbyAPI),
# "openrouter" (LLM en la nube, sin VRAM) o "hermes" (Hermes Agent lleva el bucle
# agéntico con sus herramientas y Luka pone la voz; usa el sidecar de exllama).
# Cámbialo con: asistenteia engine litert|exllama|openrouter|hermes. Uno a la vez.
AI_ENGINE=litert

# --- MOTOR EXLLAMA (solo si AI_ENGINE=exllama) ---
# Sidecar OpenAI-compatible (TabbyAPI + ExLlamaV3) en GPU. Lo instala y gestiona
# la CLI (asistenteia engine install / start / stop).
EXLLAMA_BASE_URL=http://127.0.0.1:5000
# Modelo del catálogo. Lo gestiona 'asistenteia engine model':
#   qwen3-8b -> Qwen3-8B-exl3-4bpw (texto+tools)
#   qwen3-vl -> Qwen3-VL-8B-Instruct-3.5bpw (texto+tools+visión)
EXLLAMA_MODEL=Qwen3-8B-exl3-4bpw
EXLLAMA_API_KEY=
# Razonamiento de Qwen3 (<think>): off por defecto (latencia/tokens en voz).
EXLLAMA_THINKING=False
# Visión: lo ajusta 'engine model' según el modelo (True solo con un VL).
EXLLAMA_VISION=False
# Arrancar/parar TabbyAPI junto al asistente (como LiteRT se carga solo).
EXLLAMA_AUTOSTART=True
# Carpeta de la instalación de TabbyAPI (vacío => <raíz>/exllama/tabbyAPI).
EXLLAMA_TABBY_DIR=

# --- MOTOR HERMES (solo si AI_ENGINE=hermes) ---
# Hermes Agent lleva el bucle agéntico con SUS herramientas (terminal, ficheros, web,
# navegador, subagentes) y Luka pone la voz, el STT/TTS y el satélite. Las herramientas
# de Luka le llegan por MCP desde el propio proceso del asistente (src/mcp_server.py).
# Instálalo con: asistenteia engine hermes install
#
# El LLM sale del MISMO sidecar TabbyAPI que exllama (por eso reutiliza EXLLAMA_BASE_URL),
# pero con otro perfil, que escribe la CLI al cambiar de motor: modelo más cuantizado,
# 64k de contexto y caché Q4, porque Hermes pide 64k mínimo y con el perfil de Luka no
# entra en 8 GiB. Al volver a exllama se restaura el tuyo (incluida EXLLAMA_CTX).
HERMES_DIR=~/.asistenteia/hermes
# Vacío => <HERMES_DIR>/.venv/bin/python (el que crea 'uv sync').
HERMES_PYTHON=
# Modelo del perfil hermes en local (TabbyAPI). Debe ser de una familia con parser de tools en TabbyAPI
# (Qwen3.5, Qwen3-Coder, Gemma4, GLM-4.5+, MiniMax-M2, Mistral).
HERMES_MODEL=Qwen3.5-9B-exl3-3.00bpw
HERMES_CTX=65536
HERMES_CACHE_MODE=Q4
# Si True, Hermes usa un modelo de OpenRouter en la nube en vez del sidecar local TabbyAPI.
# Reutiliza OPENROUTER_API_KEY. Configúralo con: asistenteia engine hermes model
HERMES_USE_OPENROUTER=False
HERMES_OPENROUTER_MODEL=deepseek/deepseek-v3.2
# Modelo(s) de fallback de Hermes (para failover y tareas complejas). Configurable con:
# asistenteia engine hermes fallback
HERMES_FALLBACK_MODELS=minimax/minimax-m2.5
# Alto a propósito: un turno agéntico puede encadenar varias herramientas.
HERMES_TIMEOUT=600
HERMES_MAX_ITERATIONS=8
# Generoso: los modelos "thinking" emiten TODO el razonamiento antes de la respuesta,
# así que con poco presupuesto la respuesta sale vacía (medido: 655 caracteres de
# razonamiento para calcular 3+4).
HERMES_MAX_TOKENS=4096
# Toolsets de Hermes (listas separadas por comas; vacío = sus valores por defecto).
HERMES_ENABLED_TOOLSETS=
# 'tts' apagado: Hermes hablaría por su cuenta, fuera del pipeline de audio de Luka.
HERMES_DISABLED_TOOLSETS=tts
# Activar TTS propio de Hermes (asistenteia engine hermes tts on|off):
HERMES_TTS=False
# Su memoria persistente engorda el prompt fijo de cada llamada.
HERMES_SKIP_MEMORY=True

# --- MOTOR OPENROUTER (solo si AI_ENGINE=openrouter) ---
# LLM en la nube por HTTP: no usa la GPU ni descarga pesos. Solo modelos GRATIS y
# con herramientas; elígelos con 'asistenteia engine openrouter model'.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Gemma 4 31B: el free más capaz que además acepta imágenes (cámara y pantalla).
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Reserva si el principal falla: los modelos gratis salen de un pool COMPARTIDO que se
# satura a ratos (429) aunque tu cuota esté intacta. OpenRouter enruta solo al siguiente.
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-nano-12b-v2-vl:free
# TU API key de https://openrouter.ai/keys. Ponla con:
#   asistenteia engine openrouter key <TU_API_KEY>
# Vive SOLO aquí (el .env está en .gitignore): no la subas nunca a git.
OPENROUTER_API_KEY=
# Visión: lo ajusta 'engine openrouter model' según el modelo elegido.
OPENROUTER_VISION=True

# --- ASISTENTE ---
# Nº de turnos de conversación que se recuerdan
MAX_HISTORY=10

# --- TTS (KOKORO) ---
# Idiomas: 'e' (Español), 'a' (American English), 'b' (British English)
KOKORO_LANG=e
# VOCES DISPONIBLES:
#   Español hombre: em_alex (joven/profesional), em_santa (profunda y cálida)
#   Español mujer:  ef_dora (clara y expresiva)
#   Inglés:         af_heart, af_bella, am_adam, bf_emma
KOKORO_VOICE=em_alex

# --- STT (RECONOCIMIENTO DE VOZ) ---
# Por defecto se usa el audio nativo de Gemma (un solo modelo multimodal).
# Pon STT_USE_GEMMA_AUDIO=False para usar faster-whisper en su lugar.
STT_USE_GEMMA_AUDIO=False
# Ajustes de faster-whisper (solo aplican si STT_USE_GEMMA_AUDIO=False):
# Modelo: large-v3-turbo, large-v3, medium, small... o ruta a un modelo CT2.
STT_MODEL=large-v3-turbo
# Dispositivo: cpu (la GPU requiere VRAM libre y CUDA 12 + cuDNN 9)
STT_DEVICE=cpu
# Cuantización (CPU): int8 (máx. velocidad) | int16 (intermedio) | float32 (máx. calidad)
STT_COMPUTE_TYPE=int8
# Idioma de la transcripción
STT_LANGUAGE=es
# Hilos de CPU (sube hasta el nº de núcleos físicos)
STT_THREADS=8
# VAD Silero: recorta silencios y evita alucinaciones
STT_VAD=True
# Prompt inicial que sesga el reconocimiento hacia tu vocabulario (opcional)
# STT_PROMPT=Comandos de voz en español para el asistente Luka...

# --- WAKE WORD (Sherpa-ONNX KWS) ---
# Activar/desactivar la escucha por palabra de activación ("LUKA")
WAKE_WORD_ENABLED=True
# Archivos del modelo (incluidos en el repositorio, rutas relativas a la raíz)
WAKE_WORD_KEYWORDS_FILE=models/sherpa-kws/keywords.txt
WAKE_WORD_MODEL_DIR=models/sherpa-kws
# Umbral de detección (0.0 a 1.0). Más bajo = más sensible.
WAKE_WORD_THRESHOLD=0.10

# --- SEGURIDAD Y CIFRADO ---
# Token de acceso para la API y la interfaz web. El instalador genera uno seguro.
# Déjalo vacío para desactivar la autenticación (solo desarrollo local).
API_TOKEN=
# Rutas de los certificados SSL/TLS para HTTPS (relativas a la raíz del proyecto).
# Déjalas vacías para usar HTTP plano. El instalador genera certificados autofirmados.
SSL_KEYFILE=config/certs/key.pem
SSL_CERTFILE=config/certs/cert.pem
