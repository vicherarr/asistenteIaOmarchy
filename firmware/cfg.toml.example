# Configuración del firmware luka-speaker.
#
# Copia este archivo a `cfg.toml` y rellénalo. `cfg.toml` está en .gitignore:
# NUNCA se versiona, porque lleva la clave de tu WiFi y el token de la API.
#
# Los valores se leen en tiempo de COMPILACIÓN (build.rs de luka-config) y quedan
# empotrados en el binario como constantes. Si cambias algo aquí, recompila.

[wifi]
ssid = "TU_SSID"
password = "TU_CLAVE_WIFI"

[server]
# IP del PC donde corre `asistenteia` (el servidor FastAPI).
host = "192.168.1.100"
port = 8765
# Debe coincidir EXACTAMENTE con el API_TOKEN del .env del asistente.
api_token = ""
# Certificado del servidor, que el firmware FIJA (pinning): no confía en ninguna
# CA, solo en este certificado exacto. Cópialo con ./scripts/sync-cert.sh
tls_cert = "certs/server.pem"

[device]
# Nombre con el que el dispositivo se presenta al servidor.
name = "luka-speaker"
# Brillo del anillo RGB, 0-255. Por encima de ~64 molesta de noche.
led_brightness = 48

# --- Wake word (Fase 3). Las dos claves son opcionales: si no están, valen
# --- 200 y false, así que un cfg.toml antiguo sigue compilando.

# Umbral de la palabra "Luka", 0-255, sobre la media de la ventana del detector.
# Alto = cuesta más despertarla pero casi no hay falsos positivos.
# Bajo  = despierta a la primera y también con la tele.
wake_threshold = 200

# Modo calibración: en reposo, el anillo enseña en VIOLETA cuánto se parece lo
# que oye a "Luka". Ponte a tres metros, dilo, y mira hasta dónde sube: si llega
# al final holgado, sube el umbral; si se queda a medias, bájalo.
# Para el uso diario, déjalo en false: el reposo debe ser discreto.
wake_calibration = false
