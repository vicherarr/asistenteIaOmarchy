# Configuración de ESP-IDF para el ESP32-S3-AUDIO-Board (ESP32-S3R8).

# --- Flash: la placa monta 16 MB ---
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# --- PSRAM: 8 MB en modo octal a 80 MHz ---
# Sin esto no hay sitio para el ring de pre-roll ni el jitter buffer de TTS.
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Las asignaciones grandes van a PSRAM; las pequeñas siguen en SRAM interna
# (los buffers DMA DEBEN quedarse en interna).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# --- CPU a tope: el audio en tiempo real no admite 160 MHz ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# --- Stacks ---
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192

# --- Logs ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- Watchdog: se rearma explícitamente; un cuelgue debe reiniciar, no congelar ---
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# --- TLS PSRAM ---
CONFIG_MBEDTLS_CUSTOM_MEM_ALLOC=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# --- Cámara: DMA directo a PSRAM, PROBADO Y DESCARTADO ---
# CONFIG_CAMERA_PSRAM_DMA=y existe, aplica al S3 y sobre el papel quita el
# embudo: sin ella el driver usa un búfer interno de 30 kB y copia con la CPU,
# que es lo que obliga a tener XCLK a 10 MHz en vez de 20.
#
# En esta placa NO funciona: con ella activada la imagen sale en bandas de
# basura, peor que el fallo que venía a arreglar. El log en cambio se veía mejor
# que nunca ("PSRAM DMA mode enabled", sin EV-EOF-OVF), así que solo se detecta
# mirando la foto.
#
# Sospecha, sin confirmar: coherencia de caché con la PSRAM OCTAL a 80 MHz, o el
# desalineado del búfer que hace el propio driver (Frame[0] Offset: 16). Si
# alguien lo retoma, ahí están los hilos: bajar SPIRAM_SPEED a 40M, o
# CONFIG_CAMERA_DMA_BUFFER_SIZE_MAX.
