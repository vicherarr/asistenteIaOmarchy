# Configuración de ESP-IDF para el ESP32-S3-AUDIO-Board (ESP32-S3R8).

# --- Flash: la placa monta 16 MB ---
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# --- PSRAM: 8 MB en modo octal a 80 MHz ---
# Sin esto no hay sitio para el ring de pre-roll ni el jitter buffer de TTS.
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Las asignaciones grandes van a PSRAM; las pequeñas siguen en SRAM interna
# (los buffers DMA DEBEN quedarse en interna).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# --- CPU a tope: el audio en tiempo real no admite 160 MHz ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# --- Stacks ---
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192

# --- Logs ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- Watchdog: se rearma explícitamente; un cuelgue debe reiniciar, no congelar ---
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
