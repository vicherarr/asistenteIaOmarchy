# Configuración de ESP-IDF para el ESP32-S3-AUDIO-Board (ESP32-S3R8).

# --- Flash: la placa monta 16 MB ---
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# --- PSRAM: 8 MB en modo octal a 80 MHz ---
# Sin esto no hay sitio para el ring de pre-roll ni el jitter buffer de TTS.
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Las asignaciones grandes van a PSRAM; las pequeñas siguen en SRAM interna
# (los buffers DMA DEBEN quedarse en interna).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# --- CPU a tope: el audio en tiempo real no admite 160 MHz ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# --- Stacks ---
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192

# --- Logs ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- Watchdog: se rearma explícitamente; un cuelgue debe reiniciar, no congelar ---
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# --- TLS PSRAM ---
CONFIG_MBEDTLS_CUSTOM_MEM_ALLOC=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# --- Cámara: DMA directo a PSRAM, PROBADO Y DESCARTADO ---
# CONFIG_CAMERA_PSRAM_DMA=y existe, aplica al S3 y sobre el papel quita el
# embudo: sin ella el driver usa un búfer interno de 30 kB y copia con la CPU,
# que es lo que obliga a tener XCLK a 10 MHz en vez de 20.
#
# En esta placa NO funciona: con ella activada la imagen sale en bandas de
# basura, peor que el fallo que venía a arreglar. El log en cambio se veía mejor
# que nunca ("PSRAM DMA mode enabled", sin EV-EOF-OVF), así que solo se detecta
# mirando la foto.
#
# CAUSA LOCALIZADA, en el propio driver de Espressif (target/esp32s3/ll_cam.c):
#
#   GDMA...in.conf0.indscr_burst_en = 1;   <- solo si !psram_mode
#   GDMA...in.conf0.in_data_burst_en = 1;  <- solo si !psram_mode
#   GDMA...in.conf1.in_check_owner = 0;
#   // GDMA...in.conf1.in_ext_mem_bk_size = 2;   <- COMENTADA por ellos
#
# Son dos cosas que se suman:
#
#  1. `in_ext_mem_bk_size` se queda en 0, o sea el DMA escribe a memoria externa
#     en bloques de 16 bytes contra líneas de caché de 32: nunca cuadran. Y
#     `ll_cam_get_dma_align()` devuelve `16 << ese campo`, así que el búfer se
#     alinea a 16 y no a 32. Con `= 2` serían 64, múltiplo de la línea.
#     Peor aún, la fórmula del offset suma dma_align entero cuando el puntero YA
#     venía alineado, así que tira abajo una alineación que era correcta:
#     malloc devolvió 0x3C170D80 (alineado a 32) y quedó en 0x3C170D90 (solo 16).
#
#  2. Las ráfagas se desactivan JUSTO en modo PSRAM, así que cada bloque de 16
#     bytes es una transacción suelta al bus. De ahí que no diera abasto.
#
# NO se arregla porque está dentro del componente descargado y habría que
# apropiárselo (1,3 MB versionados, sin actualizaciones). Y el beneficio es
# pequeño: una foto VGA cuesta 375 ms y la mayor parte se va COMPRIMIENDO, no
# capturando. Para acelerar, la palanca es `CALIDAD` en camera.rs.
